PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# General API rate limit (per IP). GENERAL_API_* takes precedence over legacy RATE_LIMIT_*.
GENERAL_API_RATE_LIMIT_WINDOW_MS=900000
GENERAL_API_RATE_LIMIT_MAX=600
# Legacy fallback for existing deployments; optional when GENERAL_API_* is configured.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# Client-aware rate limit for GET /api/v1/hospitals/map, independent of the general API quota
HOSPITAL_MAP_RATE_LIMIT_WINDOW_MS=60000
HOSPITAL_MAP_RATE_LIMIT_MAX=60
# Pure-IP ceiling prevents rotating client IDs from bypassing map abuse protection
HOSPITAL_MAP_IP_RATE_LIMIT_WINDOW_MS=60000
HOSPITAL_MAP_IP_RATE_LIMIT_MAX=600

# Client-aware rate limit for auth register/login endpoints, independent of the general API quota
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Pure-IP ceiling prevents rotating client IDs from bypassing auth abuse protection
AUTH_IP_RATE_LIMIT_WINDOW_MS=900000
AUTH_IP_RATE_LIMIT_MAX=100

DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432

DB_NAME=postgres

DB_USER=postgres
DB_PASSWORD=your_supabase_db_password

JWT_SECRET=your_jwt_secret

GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

LINE_CHANNEL_ID=your_line_channel_id_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_REDIRECT_URI=http://localhost:5173/login


CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=pawpal

# Gemini API key used by the AI pet-care assistant endpoint (POST /api/v1/ai-assistant)
GEMINI_API_KEY=your_gemini_api_key

# Dedicated rate limit for POST /api/v1/ai-assistant (per IP), independent of the global rate limit above
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10
